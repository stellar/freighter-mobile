<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config for debug builds of every flavor.
  Build-type resources take precedence over flavor resources, so this overrides
  both the dev and prod flavor configs in devDebug/prodDebug while leaving the
  release variants untouched (prodRelease stays strict, devRelease keeps the
  loopback allowance the E2E mock-dapp needs).

  Debug builds load JS from the Metro bundler over cleartext HTTP, so loopback
  and the emulator-host aliases must be permitted regardless of whether RN
  resolves the host to localhost (physical device via adb reverse), 10.0.2.2
  (stock Android emulator), or 10.0.3.2 (Genymotion).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
