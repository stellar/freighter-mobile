<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!--
          Paint the window backdrop with the app's page color. Under Android 15+
          enforced edge-to-edge the system bars are transparent and show this
          window background, so without it the strips fall back to the platform
          default and stop matching the app. app_background carries a
          values-night counterpart, so this follows the device.
        -->
        <item name="android:windowBackground">@color/app_background</item>
        <!--
          The recents screen shows a placeholder for this window rather than a
          screenshot, since it is FLAG_SECURE, and paints the placeholder's
          body with this. MainActivity sets it directly on API 33+; this covers
          older releases, where there is no public API to do so.
        -->
        <item name="android:colorBackground">@color/app_background</item>
    </style>

    <style name="BootTheme" parent="Theme.BootSplash">
        <item name="bootSplashBackground">@color/bootsplash_background</item>
        <item name="bootSplashLogo">@drawable/bootsplash_logo</item>
        <item name="postBootSplashTheme">@style/AppTheme</item>
    </style>
</resources>
