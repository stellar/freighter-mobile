{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "types": ["styled-components-react-native", "@types/jest"],
    "baseUrl": "src/",
    "paths": {
      "__tests__/*": ["../__tests__/*"]
    }
  },
  "include": [
    "src",
    "__tests__",
    "*.js",
    "*.ts",
    "**/*.ts",
    "**/*.tsx",
    "__mocks__",
    "jest/**/*.js",
    "eslint.config.mjs",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "eslint-plugin-translations/index.js",
    "scripts/**/*.js",
    "mock-dapp",
    "**/node_modules",
    "**/Pods"
  ]
}
